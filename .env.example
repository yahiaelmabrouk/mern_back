# Copier ce fichier en .env (en local) -- NE JAMAIS pousser .env sur GitHub
PORT=5000
JWT_SECRET=remplacer_par_une_longue_phrase_secrete
# URI copiee depuis MongoDB Atlas (ou mongodb://127.0.0.1:27017/taskflow en local)
MONGODB_URI=mongodb+srv://etudiant:MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/taskflow
# En production uniquement : adresse du front-end Vercel (sans / final)
CLIENT_URL=https://mon-taskflow.vercel.app
